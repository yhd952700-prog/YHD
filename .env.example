APP_ENV=staging
DATABASE_URL=sqlite:///./verify_metrics.db
STAGING_DATABASE_URL=postgresql://user:password@host:5432/app_db
SECRET_KEY=replace-me
JWT_SECRET=replace-me
REDIS_PASSWORD=replace-me
LOG_LEVEL=INFO
METRICS_PERSIST=1

# kernel foundation 包（LiuHao-O/packages/kernel/）必填配置 —— 缺失会在首次
# get_settings() 访问时 fail-fast（pydantic ValidationError）
LHX_POSTGRES_DSN=postgresql://user:password@localhost:5432/liuhao_x
LHX_REDIS_DSN=redis://localhost:6379/0
LHX_SECRET_KEY=replace-me-lhx

# 模型 provider（os.environ 优先，.env 兜底）
# 可选：ollama（本地自托管，无需 key）/ openai / anthropic / google / moonshot / deepseek / mock
AI_PROVIDER_TYPE=ollama
AI_PROVIDER_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
# 使用云 provider 时填 key：
# AI_PROVIDER_KEY=your-api-key
