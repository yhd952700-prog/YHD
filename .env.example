# =============================================================================
# LiuHao AI OS — 环境变量示例（.env.example）
# =============================================================================
# 用法：cp .env.example .env，然后把全部 replace-me / CHANGE_ME 占位换成真实值。
# 变量来源：本文件只收录 config/docker.env、src/ 与 docker-compose*.yml 中
# 真实出现过的变量名（不编造）。src/ 里另有约 140 个细分调优变量未在此逐一
# 列出，按需 grep `os.environ` / `os.getenv` 查代码。
#
# 生成随机密钥（SECRET_KEY / JWT_SECRET_KEY / LHX_SECRET_KEY 等通用）：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# 占位串（replace-me / change-me / CHANGE_ME / ***）会被应用启动时拒绝，
# 等同于没设 —— 已知密钥比随机密钥更危险。生产建议用 Docker Secrets /
# Vault / K8s Secret，而不是明文 env 文件。
# =============================================================================

# -----------------------------------------------------------------------------
# 必填 —— 缺失会 fail-fast 或拒绝启动
# -----------------------------------------------------------------------------
# 部署姿态。生产改为 production；开发/ staging 按实际填。
APP_ENV=staging
LIUHAO_ENV=staging
# 应用主密钥。必须替换 replace-me，否则应用拒绝启动。
SECRET_KEY=replace-me
# JWT 签名密钥（HS256），canonical 名。docker-compose.prod.yml 强制要求
# JWT_SECRET_KEY（未设置时 compose 直接拒绝启动）；多 worker 必须共享同一把，
# 否则重启即全端登出、登录后随机 401。必须替换 replace-me。
JWT_SECRET_KEY=replace-me
# 兼容别名：代码（src/security/jwt_handler.py）会依次读 LIUHAO_JWT_SECRET、
# JWT_SECRET_KEY、JWT_SECRET，三者任填其一即可生效；但生产请只用上面这个
# canonical 名 JWT_SECRET_KEY，避免三处各写一把造成漂移。旧名仅作兼容，勿新增。
# LIUHAO_JWT_SECRET=
# JWT_SECRET=
# 人类身份注册表行级校验密钥（HC-11 / U6）。不设 ⇒ 表中每一行都被拒绝 ⇒
# 系统承认的人类数为 0（无人能登录/审批）。存量身份表升级后必须重新登记每个人。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
LIUHAO_HUMAN_IDENTITIES_INTEGRITY_KEY=
# kernel foundation 包（LiuHao-O/packages/kernel/）必填；缺失会在首次
# get_settings() 访问时 fail-fast（pydantic ValidationError）。
# 来源：LiuHao-O/packages/kernel/config.py（env_prefix="LHX_" + 各字段 alias），
# 是 LHX_* 唯一的读取方；src/ 不读这些变量。
LHX_POSTGRES_DSN=postgresql://user:password@localhost:5432/liuhao_x
LHX_REDIS_DSN=redis://localhost:6379/0
# LHX 主密钥，必须替换 replace-me。
LHX_SECRET_KEY=replace-me

# -----------------------------------------------------------------------------
# 数据库 —— 默认 SQLite，不需要 Postgres；切 Postgres 时填本节
# -----------------------------------------------------------------------------
# 指标库（可选）。不设置时自动落在数据根：<data>/verify_metrics.db。
# 显式写相对路径会按**当前工作目录**解析 —— 用户从别的目录启动时就会把库
# 悄悄写进 C 盘，所以只在确实要外接数据库时才设置绝对路径 / PG URL。
# DATABASE_URL=sqlite:///./verify_metrics.db
# 外接 Postgres 时（config/docker.env 的生产值）：
# DATABASE_URL=postgresql://user:password@host:5432/app_db
# docker-compose infra profile 的 Postgres 服务用（POSTGRES_PASSWORD 无默认值，
# docker-compose.yml 强制要求设置；prod compose 默认 liuhao，仅作开发兜底）。
POSTGRES_USER=liuhao
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=liuhao
# ⚠ 未接线：以下 5 个代码无读取方（默认 SQLite，无 PG 连接池代码；填了不生效）。
# LIUHAO_DB_POOL_SIZE=20
# LIUHAO_DB_MAX_OVERFLOW=40
# LIUHAO_DB_STATEMENT_TIMEOUT_MS=15000
# LIUHAO_MEMORY_DSN=postgresql://user:password@host:5432/liuhao_memory
# LIUHAO_KNOWLEDGE_DSN=postgresql://user:password@host:5432/liuhao_knowledge

# -----------------------------------------------------------------------------
# 本地 SQLite 各库落盘路径（可选；不设时走各模块默认数据根）
# -----------------------------------------------------------------------------
# 审计库。生产务必指向持久卷路径（docker-compose.prod.yml 指向 /app/data/audit_store.db）。
AUDIT_DB_PATH=
AUDIT_DB_BACKUP_PATH=
# 会话库 / 记忆库。
CONVERSATION_DB_PATH=
MEMORY_DB_PATH=
# 知识记忆库（src/ai/knowledge/store.py 的 LIUHAO_KNOWLEDGE_MEMORY_DB）与账号记忆库。
LIUHAO_KNOWLEDGE_MEMORY_DB=
LIUHAO_ACCOUNT_MEMORY_DB=
# 身份库 / 登录凭据库 / JWT 吊销黑名单（默认路径见 docker-compose.prod.yml）。
LIUHAO_HUMAN_IDENTITIES_DB=
LIUHAO_AUTH_SECRETS_FILE=
LIUHAO_JWT_REVOCATION_DB=

# -----------------------------------------------------------------------------
# Redis（可选；默认 broker 是本地 SQLite，见 LIUHAO_TASK_BROKER）
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# 必须替换 replace-me；docker-compose infra/redis 服务用 --requirepass 校验。
REDIS_PASSWORD=replace-me
# ⚠ 未接线：REDIS_DB / REDIS_SSL / LIUHAO_REDIS_KEY_PREFIX 代码无读取方。
# REDIS_DB=0
# REDIS_SSL=false
# LIUHAO_REDIS_KEY_PREFIX=liuhao:prod:
# 任务队列后端（已接线，src/tasks/broker.py）：默认 sqlite；改 redis 时两项都要填。
LIUHAO_TASK_BROKER=sqlite
# LIUHAO_REDIS_URL=redis://:replace-me@localhost:6379/0

# -----------------------------------------------------------------------------
# 安全 —— 字段级加密与审计锚定（可选，按需）
# -----------------------------------------------------------------------------
# 字段级加密主密钥（AES-256-GCM）。真名是 ENCRYPTION_MASTER_KEY
#（docker-compose.prod.yml 透传，config/production/config.py 读取）；
#旧名 LIUHAO_ENCRYPTION_MASTER_KEY 代码从不读取，不要用。
ENCRYPTION_MASTER_KEY=
# LIUHAO_ENCRYPTION_MASTER_KEY=
# ⚠ 未接线：LIUHAO_ANCHOR_KEY_PATH 代码无读取方（审计外部锚定未接线）。
# LIUHAO_ANCHOR_KEY_PATH=

# -----------------------------------------------------------------------------
# 应用基础与服务监听（可选，都有默认值）
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
TZ=Asia/Shanghai
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
# 网关监听地址/端口（已接线：src/gateway/__main__.py 只读 HOST / PORT）。
# 旧名 LIUHAO_SERVER_HOST / LIUHAO_SERVER_PORT 代码从不读取，已删；
# LIUHAO_SERVER_WORKERS 也无读取方。
HOST=127.0.0.1
PORT=8080
# 数据根 / 控制台产物 / 工作区根（不设时走各模块默认路径）。
LIUHAO_DATA_DIR=
LIUHAO_API_PORT=8080
LIUHAO_CONSOLE_DIST=
LIUHAO_WORKSPACE_ROOT=

# -----------------------------------------------------------------------------
# 模型 provider（可选；os.environ 优先，.env 兜底）
# -----------------------------------------------------------------------------
# 可选：ollama（本地自托管，无需 key）/ openai / anthropic / google / moonshot / deepseek / mock
AI_PROVIDER_TYPE=ollama
AI_PROVIDER_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
# 通用兜底 key（优先级最高）；各家专属 key 只在通用键缺失时才读。
# AI_PROVIDER_KEY=
# 使用云 provider 时填对应 key（未启用可留空）：
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=

# -----------------------------------------------------------------------------
# 向量库 Qdrant（可选；src/ai/knowledge/memory.py 实读）
# -----------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# -----------------------------------------------------------------------------
# Vault（可选；src/integrations/vault/client.py 实读）
# -----------------------------------------------------------------------------
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
VAULT_MOUNT=secret
VAULT_KV_VERSION=2
# 仅本地开发 Vault 用：VAULT_DEV_ADDR=http://127.0.0.1:8200

# -----------------------------------------------------------------------------
# 成本与配额（可选）
# -----------------------------------------------------------------------------
# ⚠ 未接线：以下 4 个代码无读取方（成本预算在代码/CLI 里配，不读环境变量）。
# LIUHAO_COST_ENABLED=1
# LIUHAO_COST_MONTHLY_BUDGET_USD=2000
# LIUHAO_COST_DAILY_BUDGET_USD=100
# LIUHAO_COST_ON_EXCEEDED=degrade

# -----------------------------------------------------------------------------
# 可观测性（可选）
# -----------------------------------------------------------------------------
METRICS_ENABLED=1
METRICS_PERSIST=1
# ⚠ 未接线：METRICS_PORT 代码无读取方（数字只出现在 config/prometheus.yml）。
# METRICS_PORT=9090
# ⚠ 未接线：TRACING_ENABLED / TRACING_SAMPLE_RATE / TRACING_OTLP_ENDPOINT
# 代码无读取方；追踪端点真名是 OTEL_EXPORTER_OTLP_ENDPOINT
#（src/adapters/observability/opentelemetry_adapter.py）。
# TRACING_ENABLED=1
# TRACING_OTLP_ENDPOINT=http://tempo:4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# TRACING_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------------
# 告警通知（可选；与 alert-rules.yaml 配合，按渠道填写）
# -----------------------------------------------------------------------------
# 告警 webhook（已接线）：真名是 LIUHAO_ALERT_WEBHOOK
#（src/observability/alerts/sinks.py）；旧名 ALERT_WEBHOOK_URL 代码从不读取。
LIUHAO_ALERT_WEBHOOK=
LIUHAO_ALERT_WEBHOOK_TIMEOUT=
# ⚠ 未接线：以下 5 个代码无读取方（飞书/邮件/SMTP 告警通道未接线）。
# ALERT_LARK_WEBHOOK=
# ALERT_EMAIL_FROM=
# ALERT_EMAIL_TO=
# ALERT_SMTP_HOST=
# ALERT_SMTP_PORT=465
# ALERT_SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# 备份（可选）
# -----------------------------------------------------------------------------
# 备份（已接线的是下面两项，src/cli/backup_commands.py）。
LIUHAO_BACKUP_DIR=/var/backups/liuhao
LIUHAO_BACKUP_PASSWORD=
# ⚠ 未接线：以下 6 个代码无读取方（备份 S3/保留期未接线）。
# BACKUP_ENABLED=1
# BACKUP_OUTPUT_DIR=/var/backups/liuhao
# BACKUP_RETENTION_DAYS=90
# BACKUP_S3_BUCKET=liuhao-prod-backups
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# 对象存储 / 文件上传（可选）
# -----------------------------------------------------------------------------
# ⚠ 未接线：以下 5 个代码无读取方（S3 上传未接线）。
# S3_ENDPOINT=
# S3_BUCKET_UPLOADS=liuhao-uploads
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=auto

# -----------------------------------------------------------------------------
# 前端（可选）
# -----------------------------------------------------------------------------
# ⚠ 未接线：以下 2 个代码无读取方（控制台不读这两个变量）。
# FRONTEND_BASE_URL=https://ai.liuhao.example.com
# PUBLIC_API_BASE=https://ai.liuhao.example.com/api
