{
  "schema": "liuhao.selfupgrade.policy/1",
  "auto_upgrade_enabled": false,
  "require_boss_approval": true,
  "note": "自升级只允许 Boss 手动触发；本轮不设定时器、不做缺口自动装。",
  "max_consecutive_failures": 3,
  "target_install_dir": "D:\\LiuHaoTest",
  "target_data_dir": "D:\\LiuHaoTestData",
  "smoke_port": 18080,
  "stop_timeout_seconds": 60,
  "package_refusal": {
    "description": "以下任一文件与盖章清单对不上，立即拒绝出包/自升级（verify-lock 退出码 1）。",
    "lock_files": [
      "release-lock/scripts/release/package-frozen.ps1",
      "release-lock/scripts/release/freeze_checks.py",
      "release-lock/scripts/release/preflight.py",
      "release-lock/scripts/release/verify_publish_source.py",
      "release-lock/scripts/release/release-pipeline.ps1",
      "release-lock/scripts/verify_openapi_contract.py",
      "release-lock/scripts/verify_test_collection.py",
      "release-lock/scripts/verify_release_page_values.py",
      "release-lock/scripts/verify_orm_vs_db.py",
      "release-lock/scripts/verify_dependency_declaration_surface.py",
      "release-lock/scripts/verify_app_instantiation_hygiene.py",
      "release-lock/scripts/verify_doc_links.py",
      "release-lock/scripts/verify_docs_index_coverage.py",
      "release-lock/scripts/verify_doc_count_claims.py",
      "release-lock/scripts/check_docs_commands.py",
      "release-lock/scripts/lint_audit_claims.py",
      "release-lock/scripts/lint_control_claims.py",
      "release-lock/scripts/acceptance/local_attack_surface_e2e.py",
      "release-lock/packaging/build_windows_installer.ps1",
      "release-lock/packaging/build_console.py",
      "release-lock/packaging/stage_payload.py",
      "release-lock/packaging/smoke_payload.py",
      "release-lock/packaging/make_release.py",
      "release-lock/packaging/brand_guard.py",
      "release-lock/packaging/env_guard.py",
      "release-lock/packaging/sign_installer.ps1",
      "release-lock/packaging/console_provenance.py",
      "release-lock/packaging/third_party_notices.py",
      "release-lock/packaging/verify_payload_clean.py",
      "release-lock/packaging/prepare_release_venv.ps1",
      "release-lock/installer/liuhao.iss",
      "release-lock/installer/ChineseSimplified.isl",
      "release-lock/installer/assets/BEFORE-INSTALL.txt",
      "release-lock/release-gate/verify_package_compliance.py",
      "release-lock/release-gate/sbom_audit.py",
      "release-lock/release-gate/pe_imports.py",
      "release-lock/release-gate/verify_installed_compliance.py",
      "release-lock/release-gate/tools/innounp-2/innounp.exe",
      "release-lock/release-gate/tools/innounp-2/innounp-cl.txt",
      "release-lock/release-gate/tools/innounp-2/innounp.htm",
      "release-lock/release-gate/tools/innounp-2/innounp.css",
      "release-lock/release-gate/tools/innounp-2/innounp.ico",
      "release-lock/tests/test_version_consistency.py"
    ],
    "manifest_files": [
      "release-lock/MANIFEST.json",
      "release-lock/CURRENT",
      "release-lock/STAMP-LOG.jsonl",
      "release-lock/FILES.json"
    ],
    "source_files": [
      "scripts/release/package-frozen.ps1",
      "scripts/release/freeze_checks.py",
      "scripts/release/preflight.py",
      "scripts/release/verify_publish_source.py",
      "scripts/release/release-pipeline.ps1",
      "packaging/build_windows_installer.ps1",
      "packaging/build_console.py",
      "packaging/stage_payload.py",
      "packaging/make_release.py",
      "installer/liuhao.iss",
      "installer/ChineseSimplified.isl",
      "installer/assets/BEFORE-INSTALL.txt"
    ],
    "source_drift_rule": "源码与盖章副本不一致时拒绝自升级出包，先由 Boss 手动跑 stamp-lock.py 换章。",
    "not_covered": "AI 故意把 lock 文件 + MANIFEST + CURRENT + STAMP-LOG 整套重写并重算哈希，挡不住；这是本轮明确边界。"
  },
  "rollback": {
    "rollback_data": false,
    "schema_change": "禁止自动升级；如新版改过数据库结构，自升级直接拒绝，等 Boss 人工处理。"
  }
}
