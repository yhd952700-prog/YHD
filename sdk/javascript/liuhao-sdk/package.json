{
  "name": "@liuhao/sdk",
  "version": "1.0.0",
  "description": "LiuHao AI OS JavaScript SDK - TypeScript client for the LiuHao AI Operating System API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint"
  },
  "keywords": [
    "liuhao",
    "ai",
    "os",
    "sdk",
    "agent",
    "memory",
    "knowledge-base"
  ],
  "author": "LiuHao AI OS Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/liuhao-ai/liuhao-os.git",
    "directory": "sdk/javascript/liuhao-sdk"
  },
  "homepage": "https://github.com/liuhao-ai/liuhao-os#readme",
  "bugs": {
    "url": "https://github.com/liuhao-ai/liuhao-os/issues"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.2.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/index.ts",
      "!src/resources/index.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  }
}
