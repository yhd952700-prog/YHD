      "pluginVersion": "10.4.0",
      "targets": [ { "expr": "sum(rate(http_requests_total{job=\"liuhao-app\", status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"liuhao-app\"}[5m]))", "refId": "A" } ],
      "title": "5xx 错误率",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
