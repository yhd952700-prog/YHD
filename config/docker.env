# =============================================================================
# LiuHao AI OS — Docker 环境变量 (docker.env)
# =============================================================================
# 用途：
#   docker-compose 通过 `env_file: config/docker.env` 加载本文件，
#   为容器内应用提供运行时环境变量。
#
# 重要说明：
#   1. 本文件中的密钥均为「占位值」，首次部署前必须替换：
#        python -c "import secrets;print(secrets.token_urlsafe(48))"
#   2. 占位串（replace-me / CHANGE_ME / ***）会被应用启动时拒绝。
#   3. 真实生产环境建议使用 Docker Secrets / Vault / K8s Secret，
#      而不是明文 env 文件。
#   4. 变量命名约定：
#        LIUHAO_*    应用原生配置
#        *_DSN/*URL  连接串
#        *_API_KEY   第三方密钥
# =============================================================================

# -----------------------------------------------------------------------------
# 应用基础
# -----------------------------------------------------------------------------
APP_ENV=production
LIUHAO_ENV=production
LOG_LEVEL=INFO
TZ=Asia/Shanghai
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# -----------------------------------------------------------------------------
# 服务监听
# -----------------------------------------------------------------------------
LIUHAO_SERVER_HOST=0.0.0.0
LIUHAO_SERVER_PORT=8080
LIUHAO_SERVER_WORKERS=4

# -----------------------------------------------------------------------------
# 数据库（与 docker-compose 中 postgres 服务对应）
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://liuhao:CHANGE_ME_DB_PASSWORD@postgres:5432/liuhao
LIUHAO_DB_POOL_SIZE=20
LIUHAO_DB_MAX_OVERFLOW=40
LIUHAO_DB_STATEMENT_TIMEOUT_MS=15000

# 记忆库与知识库（生产拆分为独立 schema/库）
LIUHAO_MEMORY_DSN=postgresql://liuhao:CHANGE_ME_DB_PASSWORD@postgres:5432/liuhao_memory
LIUHAO_KNOWLEDGE_DSN=postgresql://liuhao:CHANGE_ME_DB_PASSWORD@postgres:5432/liuhao_knowledge

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0
REDIS_SSL=true
LIUHAO_REDIS_KEY_PREFIX=liuhao:prod:

# kernel foundation 包（LiuHao-O/packages/kernel/）必填；缺失将 fail-fast
LHX_POSTGRES_DSN=postgresql://liuhao:CHANGE_ME_DB_PASSWORD@postgres:5432/liuhao_x
LHX_REDIS_DSN=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
LHX_SECRET_KEY=CHANGE_ME_LHX_SECRET

# -----------------------------------------------------------------------------
# 安全密钥 —— 全部必须替换为高强度随机值
# -----------------------------------------------------------------------------
SECRET_KEY=CHANGE_ME_SECRET_KEY
# JWT 签名密钥（HS256）。多 worker 必须共享同一把，否则登录后随机 401。
LIUHAO_JWT_SECRET=CHANGE_ME_JWT_SECRET
# 字段级加密主密钥（AES-256-GCM）
LIUHAO_ENCRYPTION_MASTER_KEY=CHANGE_ME_ENCRYPTION_KEY
# 审计日志外部锚定私钥路径（容器内挂载）
LIUHAO_ANCHOR_KEY_PATH=/run/secrets/anchor_key.pem

# -----------------------------------------------------------------------------
# 模型提供者 —— 按需启用并填 key；未启用可留空
# -----------------------------------------------------------------------------
AI_PROVIDER_TYPE=anthropic
AI_PROVIDER_MODEL=claude-sonnet-4-5

# 本地 Ollama（compose 内服务名 ollama）
OLLAMA_BASE_URL=http://ollama:11434

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=

# -----------------------------------------------------------------------------
# 成本与配额
# -----------------------------------------------------------------------------
LIUHAO_COST_ENABLED=1
LIUHAO_COST_MONTHLY_BUDGET_USD=2000
LIUHAO_COST_DAILY_BUDGET_USD=100
LIUHAO_COST_ON_EXCEEDED=degrade

# -----------------------------------------------------------------------------
# 可观测性
# -----------------------------------------------------------------------------
METRICS_ENABLED=1
METRICS_PERSIST=1
METRICS_PORT=9090
TRACING_ENABLED=1
TRACING_OTLP_ENDPOINT=http://tempo:4317
TRACING_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------------
# 告警通知（与 alert-rules.yaml 配合；按渠道填写）
# -----------------------------------------------------------------------------
ALERT_WEBHOOK_URL=
ALERT_LARK_WEBHOOK=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=465
ALERT_SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# 备份
# -----------------------------------------------------------------------------
BACKUP_ENABLED=1
BACKUP_OUTPUT_DIR=/var/backups/liuhao
BACKUP_RETENTION_DAYS=90
BACKUP_S3_BUCKET=liuhao-prod-backups
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_ENCRYPTION_KEY=CHANGE_ME_BACKUP_KEY

# -----------------------------------------------------------------------------
# 对象存储 / 文件上传（可选）
# -----------------------------------------------------------------------------
S3_ENDPOINT=
S3_BUCKET_UPLOADS=liuhao-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# -----------------------------------------------------------------------------
# 前端
# -----------------------------------------------------------------------------
FRONTEND_BASE_URL=https://ai.liuhao.example.com
PUBLIC_API_BASE=https://ai.liuhao.example.com/api
