# =============================================================================
# LiuHao AI OS — Docker 环境变量 (docker.env)
# =============================================================================
# 用途：
#   部署环境变量参考模板（对照表）。注意：没有任何一个 docker-compose*.yml
#   用 `env_file:` 加载本文件（compose 用仓库根 `.env` + 各服务自身的
#   `environment:`），所以改这里不会自动进容器 —— 要生效请同步写进 `.env`
#   或对应 compose 文件的 environment 段。本文件头此前写“compose 通过
#   env_file 加载本文件”是错的，B组第二轮已纠正。
#
# 对账说明（B组第二轮，`python scripts/check_env_drift.py` 机械化复核）：
#   标「已接线」的变量名与代码真实读取名一致；标「⚠ 未接线」的变量代码里
#   没有任何读取方，只是部署预留位 —— 填了也不会生效，不要指望它起作用；
#   「已改名」的是旧名错了、已按代码侧的真名修正。
#
# 重要说明：
#   1. 本文件中的密钥均为「占位值」，首次部署前必须替换：
#        python -c "import secrets;print(secrets.token_urlsafe(48))"
#   2. 占位串（replace-me / CHANGE_ME / ***）会被应用启动时拒绝。
#   3. 真实生产环境建议使用 Docker Secrets / Vault / K8s Secret，
#      而不是明文 env 文件。
#   4. 变量命名约定：
#        LIUHAO_*    应用原生配置
#        *_DSN/*URL  连接串
#        *_API_KEY   第三方密钥
# =============================================================================

# -----------------------------------------------------------------------------
# 应用基础
# -----------------------------------------------------------------------------
APP_ENV=production
LIUHAO_ENV=production
LOG_LEVEL=INFO
TZ=Asia/Shanghai
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# -----------------------------------------------------------------------------
# 服务监听（已接线：网关 src/gateway/__main__.py 只读 HOST / PORT）
# -----------------------------------------------------------------------------
# 已改名：旧名 LIUHAO_SERVER_HOST / LIUHAO_SERVER_PORT 代码从不读取，
# 网关只认 HOST / PORT（Dockerfile 也用这两个）。旧名已删。
HOST=0.0.0.0
PORT=8080
# ⚠ 未接线：LIUHAO_SERVER_WORKERS 代码无读取方，worker 数不在此配置。
# LIUHAO_SERVER_WORKERS=4

# -----------------------------------------------------------------------------
# 数据库（与 docker-compose 中 postgres 服务对应）
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://liuhao:CHANGE_ME_DB_PASSWORD@postgres:5432/liuhao
# ⚠ 未接线：以下 5 个代码无读取方（默认 SQLite，无 PG 连接池代码）。
# LIUHAO_DB_POOL_SIZE=20
# LIUHAO_DB_MAX_OVERFLOW=40
# LIUHAO_DB_STATEMENT_TIMEOUT_MS=15000
# LIUHAO_MEMORY_DSN=postgresql://liuhao:CHANGE_ME_DB_PASSWORD@postgres:5432/liuhao_memory
# LIUHAO_KNOWLEDGE_DSN=postgresql://liuhao:CHANGE_ME_DB_PASSWORD@postgres:5432/liuhao_knowledge

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# ⚠ 未接线：REDIS_HOST / REDIS_PORT 代码无读取方（只出现在 k8s chart 默认值里）。
# 任务队列真正认的是 LIUHAO_TASK_BROKER + LIUHAO_REDIS_URL（src/tasks/broker.py）。
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD 只被 compose 的 redis 服务自身用于 --requirepass，不进应用。
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
# ⚠ 未接线：REDIS_DB / REDIS_SSL / LIUHAO_REDIS_KEY_PREFIX 代码无读取方。
# REDIS_DB=0
# REDIS_SSL=true
# LIUHAO_REDIS_KEY_PREFIX=liuhao:prod:
# 任务队列后端：默认 sqlite（本地），改 redis 时两项都要填。
LIUHAO_TASK_BROKER=sqlite
# LIUHAO_REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

# kernel foundation 包（LiuHao-O/packages/kernel/）必填；缺失将 fail-fast
# 读取方：LiuHao-O/packages/kernel/config.py（env_prefix="LHX_" + 各字段 alias）。
LHX_POSTGRES_DSN=postgresql://liuhao:CHANGE_ME_DB_PASSWORD@postgres:5432/liuhao_x
LHX_REDIS_DSN=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
LHX_SECRET_KEY=CHANGE_ME_LHX_SECRET

# -----------------------------------------------------------------------------
# 安全密钥 —— 全部必须替换为高强度随机值
# -----------------------------------------------------------------------------
SECRET_KEY=CHANGE_ME_SECRET_KEY
# JWT 签名密钥（HS256）。多 worker 必须共享同一把，否则登录后随机 401。
LIUHAO_JWT_SECRET=CHANGE_ME_JWT_SECRET
# 字段级加密主密钥。已改名：旧名 LIUHAO_ENCRYPTION_MASTER_KEY 代码从不读取；
# 真名是 ENCRYPTION_MASTER_KEY（docker-compose.prod.yml 透传，
# config/production/config.py 读取；生产缺失会校验失败）。
ENCRYPTION_MASTER_KEY=CHANGE_ME_ENCRYPTION_KEY
# ⚠ 未接线：LIUHAO_ANCHOR_KEY_PATH 代码无读取方（审计外部锚定未接线）。
# LIUHAO_ANCHOR_KEY_PATH=/run/secrets/anchor_key.pem

# -----------------------------------------------------------------------------
# 模型提供者 —— 按需启用并填 key；未启用可留空
# -----------------------------------------------------------------------------
AI_PROVIDER_TYPE=anthropic
AI_PROVIDER_MODEL=claude-sonnet-4-5

# 本地 Ollama（compose 内服务名 ollama）
OLLAMA_BASE_URL=http://ollama:11434

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=

# -----------------------------------------------------------------------------
# 成本与配额
# -----------------------------------------------------------------------------
# ⚠ 未接线：以下 4 个代码无读取方（成本预算在代码/CLI 里配，不读环境变量）。
# LIUHAO_COST_ENABLED=1
# LIUHAO_COST_MONTHLY_BUDGET_USD=2000
# LIUHAO_COST_DAILY_BUDGET_USD=100
# LIUHAO_COST_ON_EXCEEDED=degrade

# -----------------------------------------------------------------------------
# 可观测性
# -----------------------------------------------------------------------------
METRICS_ENABLED=1
METRICS_PERSIST=1
# ⚠ 未接线：METRICS_PORT 代码无读取方（数字只出现在 config/prometheus.yml）。
# METRICS_PORT=9090
# ⚠ 未接线：TRACING_ENABLED / TRACING_SAMPLE_RATE 代码无读取方。
# TRACING_ENABLED=1
# TRACING_SAMPLE_RATE=0.1
# 已改名：旧名 TRACING_OTLP_ENDPOINT 代码从不读取；真名是
# OTEL_EXPORTER_OTLP_ENDPOINT（src/adapters/observability/opentelemetry_adapter.py）。
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317

# -----------------------------------------------------------------------------
# 告警通知（与 alert-rules.yaml 配合；按渠道填写）
# -----------------------------------------------------------------------------
# 已改名：旧名 ALERT_WEBHOOK_URL 代码从不读取；真名是 LIUHAO_ALERT_WEBHOOK
#（src/observability/alerts/sinks.py 的 WEBHOOK_ENV）。
LIUHAO_ALERT_WEBHOOK=
LIUHAO_ALERT_WEBHOOK_TIMEOUT=
# ⚠ 未接线：以下 5 个代码无读取方（飞书/邮件/SMTP 告警通道未接线）。
# ALERT_LARK_WEBHOOK=
# ALERT_EMAIL_FROM=
# ALERT_EMAIL_TO=
# ALERT_SMTP_HOST=
# ALERT_SMTP_PORT=465
# ALERT_SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# 备份
# -----------------------------------------------------------------------------
# 已接线的是下面两项（src/cli/backup_commands.py）：
#   LIUHAO_BACKUP_DIR / LIUHAO_BACKUP_PASSWORD
LIUHAO_BACKUP_DIR=/var/backups/liuhao
LIUHAO_BACKUP_PASSWORD=
# ⚠ 未接线：以下 6 个代码无读取方（备份 S3/保留期未接线）。
# BACKUP_ENABLED=1
# BACKUP_OUTPUT_DIR=/var/backups/liuhao
# BACKUP_RETENTION_DAYS=90
# BACKUP_S3_BUCKET=liuhao-prod-backups
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_ENCRYPTION_KEY=CHANGE_ME_BACKUP_KEY

# -----------------------------------------------------------------------------
# 对象存储 / 文件上传（可选）
# -----------------------------------------------------------------------------
# ⚠ 未接线：以下 5 个代码无读取方（S3 上传未接线）。
# S3_ENDPOINT=
# S3_BUCKET_UPLOADS=liuhao-uploads
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=auto

# -----------------------------------------------------------------------------
# 前端
# -----------------------------------------------------------------------------
# ⚠ 未接线：以下 2 个代码无读取方（控制台不读这两个变量）。
# FRONTEND_BASE_URL=https://ai.liuhao.example.com
# PUBLIC_API_BASE=https://ai.liuhao.example.com/api
