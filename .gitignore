# ===== 错位文件 =====
=1.0.0

# ===== 独立子项目（2026-09-06 并入，含各自的 git/配置，不纳入本仓库版本管理） =====
LIUHAO_AI_TEAM_V1.0/
# 十源 packages 层是本项目核心架构层（三层骨架之二），纳入本仓库；
# 其余 LiuHao-O 脚手架（docker-compose/infrastructure/migrations 等空壳）仍忽略。
LiuHao-O/*
!LiuHao-O/pyproject.toml
!LiuHao-O/packages/
# ===== 人类身份登记表（Policy C-7）=====
# 含真实人员姓名，且随部署主机而变 —— 属运维数据，不入库。
# 样例见 config/human_identities.example.json
config/human_identities.json

# ===== 登录凭据库（PBKDF2 salt+hash）=====
# 虽然只存哈希不存明文，它仍是凭据材料：入库=每个克隆者都是凭据持有者。
# 由 scripts/register_human_identity.py --password 生成（默认落在这里）。
config/auth_secrets.json

# ===== 发布包（由 scripts/build_cloud_bundle.py 生成）=====
# 它是 src/ 与前端 dist 的副本，入库只会带来 200 个必然漂移的冗余文件。
# 需要时重新生成即可：python scripts/build_cloud_bundle.py
deploy/cloud/

# ===== 发布工具状态（认领 appId ↔ 本地目录，含本机绝对路径）=====
# 发布后由工具写入，仅对本机有效：换机器/换目录都会重建。
.wbapp_*.genie

# ===== 运行期状态（身份库等）=====
# *.sqlite3 已在上面忽略；补上 SQLite WAL 模式的伴生文件。
data/
*.sqlite3-wal
*.sqlite3-shm

# ===== 测试/脚本产物 =====
# retention 冷归档测试落在本仓库根，属生成物。
.retention_cold/
# Windows 下 `2>nul` / `> nul` 重定向会在当前目录留一个 0 字节的 nul 文件。
/nul

# RELEASE-READINESS-CONTRACT 的机器判决，由 scripts/verify_readiness.py 生成。
# 它嵌有 generated_at 时间戳、environment（os/python）与依赖插件的门禁结果 ——
# 逐次重生成即不同，故提交它等于「把一份陈旧副本伪装成当前证据」：谁看到旧的
# PASS 数谁就误判就绪度。判决的正确载体是运行本身 —— CI 在 release-readiness.yml
# 跑 `--full`，本地跑 `python scripts/verify_readiness.py`。基线类产物
# （test_baseline.json / bench_baseline.json）是受跟踪的输入，与此不同。
/scripts/readiness_report.json

# ===== 插件注册表索引（运行产物，非受跟踪输入）=====
# PluginRegistry._save_index（src/kernels/plugin/__init__.py，写盘见 :443-453）产出的运行快照：
# generated_at（datetime.now）随每次运行漂移，plugins 内容随当次进程注册了哪些插件而变
# （本文件曾因此带出一条"注册了却没有 module_path、加载失败"的幽灵条目）。提交它等于把一份
# 随时会被重写的墙钟快照当作证据 —— 与上面 readiness_report.json 同类。它的正确读法是
# 运行时产物 / GET /v1/plugins，而非一份受跟踪文件。
# 一致性说明：并行的第二套插件注册表 data/plugins/registry.json 早已被上方 `data/`
# 规则（.gitignore:114）忽略；本条目只是补上同样的处置。
/plugins/registry_index.json

node_modules/
frontend/dist/
frontend/node_modules/
