{
  "servers": [
    {
      "name": "filesystem",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "./data"
      ],
      "env": {},
      "enabled": true
    },
    {
      "name": "git",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-git",
        "--repository",
        "."
      ],
      "env": {},
      "enabled": true
    },
    {
      "name": "sqlite",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sqlite",
        "./data/mcp.db"
      ],
      "env": {},
      "enabled": true
    },
    {
      "name": "brave-search",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-brave-search"
      ],
      "env": {
        "BRAVE_API_KEY": "[REDACTED]"
      },
      "enabled": false
    }
  ]
}
